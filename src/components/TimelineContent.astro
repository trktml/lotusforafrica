---
import logo from '../assets/img/logo.png';
import { Image } from 'astro:assets';
import t from '../utils/translationTools';

interface Props {
    source: ImageMetadata | string;
    title?: string;
}

const { source, title } = Astro.props;

const isVideo = typeof source === 'string';
const isImage = !isVideo;
---

<div class="cd-timeline-block">
    <div class="cd-timeline-img cd-movie">
        <Image
            width={30}
            height={30}
            src={logo}
            alt="site logo for timeline image"
            loading="lazy"
        />
    </div>
    <div class="cd-timeline-content">
        <h3 style="color: #0f172a; margin: 0; margin-bottom: 8px">{title}</h3>
        <div>
            {
                isImage && title && (
                    <a href={(source as ImageMetadata).src} target="_blank" rel="noopener noreferrer">
                        <Image
                            width={500}
                            src={source as ImageMetadata}
                            alt={title}
                            class="content-image"
                            loading="lazy"
                            decoding="async"
                        />
                    </a>
                )
            }

            {
                isVideo && (
                    <video
                        class="lazy-video"
                        style="width: 100%; height: 70vh; object-fit: cover;"
                        data-src={source}
                        controls
                        muted
                        loop
                        playsinline
                        preload="none"
                    />
                )
            }
        </div>
        <!-- <span class="cd-date">Feb 26</span> -->
    </div>
</div>
