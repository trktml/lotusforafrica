---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

// import translations
import translations, {
    convertPageTitle,
    localeLink,
} from '../utils/translationTools';
const t = translations(Astro.url);
---

<BaseLayout
    title={convertPageTitle(t.contact, t.title)}
    description={t.description}
>
    <div class="container py-4 col-11 col-lg-9">
        <div class="text-center mb-5">
            <h1 class="fw-bold display-5 text-dark mb-2">{t.contact}</h1>
            <p class="text-muted fs-6">Reach out to us for inquiries, donations, or partnerships.</p>
        </div>

        <div class="row g-4">
            <!-- Address Card -->
            <div class="col-12 col-md-4">
                <div class="foundation-card p-4 h-100 d-flex flex-column align-items-center text-center">
                    <div class="contact-icon-badge mb-3">
                        📍
                    </div>
                    <h3 class="fs-5 fw-bold text-dark mb-2">Location</h3>
                    <p class="text-muted mb-3" style="font-size: 0.95rem; color: #475569;">
                        24th Street, Sinkor, Airfeld-Shortcut<br />Monrovia, Republic of Liberia
                    </p>
                    <span class="badge bg-warning bg-opacity-20 text-dark border border-warning mt-auto py-2 px-3 fw-bold" style="font-size: 0.78rem;">
                        {t.centerOfficeUnderConstruction}
                    </span>
                </div>
            </div>

            <!-- Phone Card -->
            <div class="col-12 col-md-4">
                <div class="foundation-card p-4 h-100 d-flex flex-column align-items-center text-center">
                    <div class="contact-icon-badge mb-3">
                        📞
                    </div>
                    <h3 class="fs-5 fw-bold text-dark mb-2">Phone / WhatsApp</h3>
                    <a href="tel:+231888693902" class="contact-link fs-5 fw-bold text-primary mb-3">
                        +231 88 869 3902
                    </a>
                    <a href="https://api.whatsapp.com/send?phone=231888693902" target="_blank" class="btn btn-sm btn-success rounded-2 px-3 py-2 fw-bold text-white mt-auto">
                        💬 Open WhatsApp
                    </a>
                </div>
            </div>

            <!-- Email Card -->
            <div class="col-12 col-md-4">
                <div class="foundation-card p-4 h-100 d-flex flex-column align-items-center text-center">
                    <div class="contact-icon-badge mb-3">
                        ✉️
                    </div>
                    <h3 class="fs-5 fw-bold text-dark mb-2">Email Address</h3>
                    <a href="mailto:mstoneiron66@gmail.com" class="contact-link fs-6 fw-bold text-primary mb-3 text-break">
                        mstoneiron66@gmail.com
                    </a>
                    <a href="mailto:mstoneiron66@gmail.com" class="btn btn-sm btn-primary rounded-2 px-3 py-2 fw-bold text-white mt-auto">
                        📩 Send Message
                    </a>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .contact-icon-badge {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.65rem;
        box-shadow: 0 2px 8px rgba(29, 78, 216, 0.1);
    }
    .contact-link {
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .contact-link:hover {
        color: #1d4ed8 !important;
        text-decoration: underline;
    }
</style>
