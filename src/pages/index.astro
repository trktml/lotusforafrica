---
import { Image } from 'astro:assets';

import IndexLayout from '../layouts/IndexLayout.astro';
import Slider from '../components/Slider';

// images for link backgrounds
import bridgeImage from '../assets/img/activities/bridge.webp';
import orphanageImage from '../assets/img/activities/orphanage.webp';
import studentsImage from '../assets/img/activities/students.webp';
import wellImage from '../assets/img/activities/well.webp';

import '../scss/pages/home.scss';

// translations
import translations, {
    localeLink,
} from '../utils/translationTools';
const t = translations(Astro.url);

const imageWidth = 500;
---

<IndexLayout title={t.title} description={t.description}>
    <div id="page-top" class="py-4 py-md-5">
        <div class="container">
            <!-- 1. HERO SECTION -->
            <div class="row align-items-center justify-content-center text-center mb-5">


                <!-- Featured Image Slider Container -->
                <div class="col-12 col-lg-10">
                    <div class="slider-wrapper">
                        <Slider client:only="react" />
                    </div>
                </div>
            </div>



            <!-- Categories Grid -->
            <div class="row g-3 col-12 col-lg-10 mx-auto justify-content-center mb-5">
                <div class="col-6 col-md-3">
                    <div class="link-cards">
                        <a href={localeLink('/wells/1/', Astro.url)}>
                            <div class="link-card-inner">
                                <Image
                                    src={wellImage}
                                    alt={t.wells}
                                    width={imageWidth}
                                />
                                <div class="link-card-text">{t.wells}</div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="link-cards">
                        <a href={localeLink('/orphanage', Astro.url)}>
                            <div class="link-card-inner">
                                <Image
                                    src={orphanageImage}
                                    alt={t.orphanage}
                                    width={imageWidth}
                                />
                                <div class="link-card-text">{t.orphanage}</div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="link-cards">
                        <a href={localeLink('/students', Astro.url)}>
                            <div class="link-card-inner">
                                <Image
                                    src={studentsImage}
                                    alt={t.students}
                                    width={imageWidth}
                                />
                                <div class="link-card-text">{t.students}</div>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="link-cards">
                        <a href={localeLink('/others', Astro.url)}>
                            <div class="link-card-inner">
                                <Image
                                    src={bridgeImage}
                                    alt={t.others}
                                    width={imageWidth}
                                />
                                <div class="link-card-text">{t.others}</div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>




        </div>
    </div>
</IndexLayout>

