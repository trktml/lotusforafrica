---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

import studentsImage from '../assets/img/activities/students.webp';

// import translations
import translations, {
    convertPageTitle,
    localeLink,
} from '../utils/translationTools';
const t = translations(Astro.url);
---

<BaseLayout
    title={convertPageTitle(t.students, t.title)}
    description={t.description}
>
    <div class="container py-4 col-11 col-lg-9">
        <div class="text-center mb-4">
            <h1 class="fw-bold display-5 text-dark mb-2">{t.students}</h1>
        </div>

        <div class="foundation-card p-4 p-md-5">
            <div class="row align-items-center g-4">
                <div class="col-12 col-md-6">
                    <p class="fs-5 text-muted leading-relaxed mb-0">
                        {t.studentsText}
                    </p>
                </div>
                <div class="col-12 col-md-6 text-center">
                    <div class="overflow-hidden rounded-3 shadow-sm border border-slate-200">
                        <Image
                            src={studentsImage}
                            alt="students picture"
                            width={500}
                            class="img-fluid w-100 feature-img"
                        />
                    </div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .feature-img {
        max-height: 400px;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .feature-img:hover {
        transform: scale(1.05);
    }
</style>
