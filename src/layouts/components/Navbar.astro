---
import { Image } from 'astro:assets';
import navLogo from '../../assets/img/logo.png';
import LanguageSelector from './LanguageSelector.astro';

// translations
import translations, {
    convertPageTitle,
    localeLink,
} from '../../utils/translationTools';
const t = translations(Astro.url);

const currentPath = Astro.url.pathname;
const isActive = (path: string): boolean => {
    const targetLink = localeLink(path, Astro.url);
    const normCurrent = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
    const normTarget = targetLink.endsWith('/') ? targetLink : `${targetLink}/`;
    return normCurrent === normTarget;
};
---

<!-- Navigation-->
<nav class="navbar navbar-expand-lg text-uppercase fixed-top" id="mainNav">
    <div class="container-lg h-100 d-flex align-items-center justify-content-between">
        <a
            class="navbar-brand h-100 d-flex flex-row align-items-center"
            href={localeLink('/', Astro.url)}
        >
            <Image
                class="nav-logo h-100 object-fit-contain py-1"
                src={navLogo}
                alt="navigation bar logo"
                height="45"
            />
            <div class="nav-texts">
                <div>LOTUS FOR AFRICA</div>
                <div>FOUNDATION</div>
            </div>
        </a>
        <button
            class="navbar-toggler text-white border-0"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarResponsive"
            aria-controls="navbarResponsive"
            aria-expanded="false"
            aria-label={t.menu}
            >{t.menu}
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarResponsive">
            <div class="navbar-nav ms-auto align-items-center">
                <div class="nav-item mx-0 mx-lg-1">
                    <a
                        class:list={[
                            'nav-link py-1 px-0 px-lg-3 rounded',
                            { active: isActive('/activities') },
                        ]}
                        href={localeLink('/activities', Astro.url)}
                        >{t.activities}</a
                    >
                </div>
                <div class="nav-item mx-0 mx-lg-1">
                    <a
                        class:list={[
                            'nav-link py-1 px-0 px-lg-3 rounded',
                            { active: isActive('/about') },
                        ]}
                        href={localeLink('/about', Astro.url)}>{t.aboutUs}</a
                    >
                </div>
                <div class="nav-item mx-0 mx-lg-1">
                    <a
                        class:list={[
                            'nav-link py-1 px-0 px-lg-3 rounded',
                            { active: isActive('/contact') },
                        ]}
                        href={localeLink('/contact', Astro.url)}>{t.contact}</a
                    >
                </div>
                <LanguageSelector />
            </div>
        </div>
    </div>
</nav>

