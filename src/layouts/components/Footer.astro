    <div class="container col-12 col-md-10 col-lg-8">
        <div class="divider mb-4 text-center">
            <div class="fancy">{t.contactAddressesForCharity}</div>
            <div class="hr anim"></div>
        </div>
        <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
            <a
                class="footer-social-pill"
                target="_blank"
                href="https://twitter.com/TTasdemir66"
            >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
                <span>Twitter / X</span>
            </a>
            <a
                class="footer-social-pill"
                target="_blank"
                href="mailto:mstoneiron66@gmail.com"
            >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="16" x="2" y="4" rx="2"/>
