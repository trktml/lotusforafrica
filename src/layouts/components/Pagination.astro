---
import type { Page } from 'astro';
import translations from '../../utils/translationTools';
const t = translations(Astro.url);

interface Props {
    page: Page;
    type: string;
}
const { page, type } = Astro.props;
let pageCount = Math.ceil(page.total / page.size);

const getPagesDesktop = (current: number, total: number) => {
    if (total <= 7) {
        return Array.from({ length: total }, (_, i) => i + 1);
    }
    if (current <= 4) {
        return [1, 2, 3, 4, 5, '...', total];
    }
    if (current >= total - 3) {
        return [1, '...', total - 4, total - 3, total - 2, total - 1, total];
    }
    return [1, '...', current - 1, current, current + 1, '...', total];
};

const getPagesMobile = (current: number, total: number) => {
    if (total <= 4) {
        return Array.from({ length: total }, (_, i) => i + 1);
    }
    if (current <= 2) {
        return [1, 2, '...', total];
    }
    if (current >= total - 1) {
        return [1, '...', total - 1, total];
    }
    return [1, '...', current, '...', total];
};

const pagesDesktop = getPagesDesktop(page.currentPage, pageCount);
const pagesMobile = getPagesMobile(page.currentPage, pageCount);

const getPageUrl = (p: number | string) => {
    return page.url.current.split('/').slice(0, -2).join('/') + '/' + p + '/';
};
---

<div class={`d-flex flex-column align-items-center gap-3 my-4 ${type === "start" ? "" : "flex-column-reverse"}`}>
    <div class="pagination-wrapper p-1 p-sm-2 d-inline-flex align-items-center justify-content-center">
        
        <!-- DESKTOP PAGINATION (>= 576px) -->
        <div class="d-none d-sm-flex align-items-center gap-1 gap-md-2">
            <a
                class={`pagination-nav-btn btn ${page.url.prev ? '' : 'disabled'}`}
                href={page.url.prev ? page.url.prev : '#'}
                aria-label={t.prev}
            >
                ‹ {t.prev}
            </a>

            {pagesDesktop.map((p) => {
                if (p === '...') {
                    return <span class="pagination-ellipsis px-1 text-muted fw-bold">...</span>;
                }
                const isCurrent = p === page.currentPage;
                return (
                    <a
                        class={`pagination-num-btn btn ${isCurrent ? 'active' : ''}`}
                        href={getPageUrl(p)}
                    >
                        {p}
                    </a>
                );
            })}

            <a
                class={`pagination-nav-btn btn ${page.url.next ? '' : 'disabled'}`}
                href={page.url.next ? page.url.next : '#'}
                aria-label={t.next}
            >
                {t.next} ›
            </a>
        </div>

        <!-- MOBILE PAGINATION (< 576px) -->
        <div class="d-flex d-sm-none align-items-center gap-1 flex-nowrap">
            <a
                class={`pagination-nav-btn btn btn-sm ${page.url.prev ? '' : 'disabled'}`}
                href={page.url.prev ? page.url.prev : '#'}
                aria-label={t.prev}
            >
                ‹ {t.prev}
            </a>

            {pagesMobile.map((p) => {
                if (p === '...') {
                    return <span class="pagination-ellipsis px-1 text-muted small fw-bold">...</span>;
                }
                const isCurrent = p === page.currentPage;
                return (
                    <a
                        class={`pagination-num-btn btn btn-sm ${isCurrent ? 'active' : ''}`}
                        href={getPageUrl(p)}
                    >
                        {p}
                    </a>
                );
            })}

            <a
                class={`pagination-nav-btn btn btn-sm ${page.url.next ? '' : 'disabled'}`}
                href={page.url.next ? page.url.next : '#'}
                aria-label={t.next}
            >
                {t.next} ›
            </a>
        </div>

    </div>
</div>

<style>
    .pagination-wrapper {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(11, 25, 44, 0.05);
    }
    .pagination-num-btn {
        min-width: 36px;
        height: 36px;
        padding: 0 8px;
        border-radius: 8px;
        background: #f8fafc;
        color: #1e293b;
        border: 1px solid #e2e8f0;
        font-weight: 700;
        font-size: 0.88rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }
    .pagination-num-btn:hover {
        background: #eff6ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
        transform: translateY(-1px);
    }
    .pagination-num-btn.active {
        background: #1d4ed8;
        color: #ffffff;
        border-color: #1d4ed8;
        box-shadow: 0 3px 10px rgba(29, 78, 216, 0.35);
    }
    .pagination-nav-btn {
        padding: 6px 14px;
        border-radius: 8px;
        background: #0b192c;
        color: #ffffff;
        border: 1px solid #0b192c !important;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        box-shadow: 0 2px 6px rgba(11, 25, 44, 0.15);
    }
    .pagination-nav-btn:hover:not(.disabled) {
        background: #1e3e62;
        color: #ffffff;
        border-color: #1e3e62 !important;
        transform: translateY(-1px);
    }
    .pagination-nav-btn.disabled {
        background: #f1f5f9 !important;
        color: #94a3b8 !important;
        border-color: #e2e8f0 !important;
        opacity: 0.6;
        cursor: not-allowed;
        box-shadow: none;
    }

    @media (max-width: 575.98px) {
        .pagination-num-btn {
            min-width: 32px;
            height: 32px;
            font-size: 0.8rem;
            padding: 0 4px;
        }
        .pagination-nav-btn {
            padding: 4px 10px;
            font-size: 0.78rem;
        }
    }
</style>