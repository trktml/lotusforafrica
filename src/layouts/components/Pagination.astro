---
import type { Page } from 'astro';
interface Props{
    page:Page,
    type:string
}
const {page,type} = Astro.props;
let pageCount = Math.ceil(page.total / page.size);

const getPages = (current: number, total: number) => {
    if (total <= 7) {
        return Array.from({ length: total }, (_, i) => i + 1);
    }

    if (current <= 4) {
        return [1, 2, 3, 4, 5, '...', total];
    }

    if (current >= total - 3) {
        return [1, '...', total - 4, total - 3, total - 2, total - 1, total];
    }

    return [1, '...', current - 1, current, current + 1, '...', total];
};

const pagesToDisplay = getPages(page.currentPage, pageCount);
---
<div class={`d-flex flex-column align-items-center gap-3 my-4 ${type==="start"?"":"flex-column-reverse"}`}>
    <div class="d-flex align-items-center justify-content-center flex-wrap gap-2">
        <!-- Prev Arrow -->
        <a
            class={`pagination-nav-btn btn border-0 ${page.url.prev ? '' : 'disabled opacity-50'}`}
            href={page.url.prev ? page.url.prev : '#'}
            aria-label="Previous page"
        >
            ‹ Prev
        </a>

        <!-- Page Numbers -->
        {
            pagesToDisplay.map((p) => {
                if (p === '...') {
                    return (
                        <span class="pagination-ellipsis px-2 text-muted">
                            ...
                        </span>
                    );
                }
                const isCurrent = p === page.currentPage;
                return (
                    <a
                        class={`pagination-num-btn btn ${
                            isCurrent ? 'active' : ''
                        }`}
                        href={
                            page.url.current
                                .split('/')
                                .slice(0, -2)
                                .join('/') +
                            '/' +
                            p +
                            '/'
                        }
                    >
                        {p}
                    </a>
                );
            })
        }

        <!-- Next Arrow -->
        <a
            class={`pagination-nav-btn btn border-0 ${page.url.next ? '' : 'disabled opacity-50'}`}
            href={page.url.next ? page.url.next : '#'}
            aria-label="Next page"
        >
            Next ›
        </a>
    </div>
</div>

<style>
    .pagination-num-btn {
        min-width: 36px;
        height: 36px;
        border-radius: 8px;
        background: #ffffff;
        color: #1e293b;
        border: 1px solid #e2e8f0;
        font-weight: 600;
        font-size: 0.88rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .pagination-num-btn:hover {
        background: #f1f5f9;
        color: #0f172a;
        border-color: #cbd5e1;
    }
    .pagination-num-btn.active {
        background: #0f172a;
        color: #ffffff;
        border-color: #0f172a;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.2);
    }
    .pagination-nav-btn {
        padding: 5px 14px;
        border-radius: 8px;
        background: #ffffff;
        color: #1e293b;
        border: 1px solid #e2e8f0 !important;
        font-weight: 600;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .pagination-nav-btn:hover:not(.disabled) {
        background: #f1f5f9;
        color: #0f172a;
        border-color: #cbd5e1 !important;
    }
</style>