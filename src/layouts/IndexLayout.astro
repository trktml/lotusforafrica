---
// translations
import translations, { defaultLocale } from '../utils/translationTools';
import { getLocale } from 'astro-i18n-aut';
let lang = getLocale(Astro.url) ?? defaultLocale;
const t = translations(Astro.url);

// scripts and css's
import '../scss/styles.scss';

import favicon from '../assets/favicon.ico';

// components
import Navbar from './components/Navbar.astro';
import Copyright from './components/Copyright.astro';
import Footer from './components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
    title: string;
    description: string;
    image?: string;
    type?: string;
}

const { title, description, image, type } = Astro.props;
---

<!doctype html>
<html lang={lang} translate="no">
    <head>
        <SEO title={title} description={description} image={image} type={type} />
        <!-- Favicon-->
        <link rel="icon" type="image/x-icon" href={favicon} />
    </head>
    <body>
        <main>
            <Navbar />

            <div style="margin-top: 65px;">
                <slot />
            </div>

            <div class="container my-5 col-12 col-lg-9">
                <div class="foundation-card p-4 text-center">
                    <span class="section-badge mb-2">{t.liveFeed}</span>
                    <h3 class="fw-bold mb-3 fs-4 text-primary">{t.updatesAndAnnouncements}</h3>

                    <!-- Account Tab Selector -->
                    <div class="x-feed-tabs mb-4">
                        <button type="button" class="x-feed-tab active" id="tab-btn-1" onclick="switchXFeed(1)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                            </svg>
                            @TTasdemir66
                        </button>
                        <button type="button" class="x-feed-tab" id="tab-btn-2" onclick="switchXFeed(2)">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                            </svg>
                            @Ebuzertasdemir
                        </button>
                    </div>

                    <div class="d-flex flex-column align-items-center justify-content-center overflow-hidden rounded-3 position-relative min-vh-25">
                        <div id="twitter-feeds-wrapper" class="w-100">
                            <div id="feed-container-1" class="w-100 d-flex justify-content-center">
                                <a
                                    class="twitter-timeline"
                                    data-theme="light"
                                    data-height="500"
                                    data-chrome="noheader nofooter transparent"
                                    href="https://twitter.com/TTasdemir66?ref_src=twsrc%5Etfw"
                                    >{t.tweetsBy}</a
                                >
                            </div>
                            <div id="feed-container-2" class="w-100 d-flex justify-content-center d-none">
                                <a
                                    class="twitter-timeline"
                                    data-theme="light"
                                    data-height="500"
                                    data-chrome="noheader nofooter transparent"
                                    href="https://twitter.com/Ebuzertasdemir?ref_src=twsrc%5Etfw"
                                    >{t.tweetsBy}</a
                                >
                            </div>
                        </div>

                        <div id="twitter-fallback-card" class="twitter-fallback-card p-4 text-center d-none w-100 my-2">
                            <h5 class="fw-bold mb-1 text-dark">X (Twitter)</h5>
                            <p class="text-muted small mb-4 mx-auto" style="max-width: 520px;">
                                {t.tweetsBy}
                            </p>

                            <div class="row g-3 justify-content-center">
                                <div class="col-12 col-sm-6">
                                    <div class="x-profile-card h-100">
                                        <div class="x-avatar-ring mb-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                            </svg>
                                        </div>
                                        <h5 class="fw-bold mb-1 text-dark">T. Taşdemir</h5>
                                        <span class="text-primary small fw-semibold mb-3">@TTasdemir66</span>
                                        <div class="mt-auto w-100">
                                            <a
                                                href="https://twitter.com/TTasdemir66"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="btn btn-primary rounded-pill py-2 px-3 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm w-100"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                                </svg>
                                                {t.followOnX}
                                            </a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <div class="x-profile-card h-100">
                                        <div class="x-avatar-ring mb-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                            </svg>
                                        </div>
                                        <h5 class="fw-bold mb-1 text-dark">Ebuzer Taşdemir</h5>
                                        <span class="text-primary small fw-semibold mb-3">@Ebuzertasdemir</span>
                                        <div class="mt-auto w-100">
                                            <a
                                                href="https://twitter.com/Ebuzertasdemir"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="btn btn-primary rounded-pill py-2 px-3 fw-semibold d-inline-flex align-items-center justify-content-center gap-2 shadow-sm w-100"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                                </svg>
                                                {t.followOnX}
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <script
                            is:inline
                            async
                            src="https://platform.twitter.com/widgets.js"
                            charset="utf-8"></script>
                        <script is:inline>
                            window.switchXFeed = function(tabIndex) {
                                var tab1 = document.getElementById('tab-btn-1');
                                var tab2 = document.getElementById('tab-btn-2');
                                var feed1 = document.getElementById('feed-container-1');
                                var feed2 = document.getElementById('feed-container-2');

                                if (tabIndex === 1) {
                                    if (tab1) tab1.classList.add('active');
                                    if (tab2) tab2.classList.remove('active');
                                    if (feed1) feed1.classList.remove('d-none');
                                    if (feed2) feed2.classList.add('d-none');
                                } else {
                                    if (tab2) tab2.classList.add('active');
                                    if (tab1) tab1.classList.remove('active');
                                    if (feed2) feed2.classList.remove('d-none');
                                    if (feed1) feed1.classList.add('d-none');
                                }

                                if (window.twttr && window.twttr.widgets && typeof window.twttr.widgets.load === 'function') {
                                    window.twttr.widgets.load();
                                }
                            };

                            (function initTwitterWidget() {
                                function checkWidget() {
                                    var fallback = document.getElementById('twitter-fallback-card');
                                    var feedsWrapper = document.getElementById('twitter-feeds-wrapper');
                                    
                                    if (window.twttr && window.twttr.widgets && typeof window.twttr.widgets.load === 'function') {
                                        window.twttr.widgets.load();
                                    }

                                    setTimeout(function() {
                                        var loadedIframe = document.querySelector('iframe[id^="twitter-widget-"]');
                                        if (!loadedIframe || loadedIframe.offsetHeight < 80) {
                                            if (fallback) fallback.classList.remove('d-none');
                                            if (feedsWrapper) feedsWrapper.classList.add('d-none');
                                        } else {
                                            if (fallback) fallback.classList.add('d-none');
                                            if (feedsWrapper) feedsWrapper.classList.remove('d-none');
                                        }
                                    }, 1200);
                                }

                                if (document.readyState === 'complete' || document.readyState === 'interactive') {
                                    setTimeout(checkWidget, 200);
                                } else {
                                    document.addEventListener('DOMContentLoaded', checkWidget);
                                }
                            })();
                        </script>
                    </div>
                </div>
            </div>


            <Footer />

            <Copyright />

            <!-- Core theme JS -->
            <script>
                import 'bootstrap/dist/js/bootstrap.bundle';
                import '../js/scripts';
            </script>
        </main>
    </body>
</html>
